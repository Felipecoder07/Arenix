{
  "name": "arenix-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:cliente": "npm run dev --prefix \"tela cliente\"",
    "dev": "concurrently -n \"backend,frontend,cliente\" -c \"blue,green,magenta\" \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:cliente\"",
    "test:backend": "npm run test --prefix backend",
    "test:cliente": "npm run test --prefix \"tela cliente\"",
    "test": "npm run test:backend && npm run test:cliente"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
